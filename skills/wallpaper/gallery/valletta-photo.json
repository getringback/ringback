{
  "version": 1,
  "name": "Valletta photo",
  "background": {
    "image": "card.wallpaper-photo"
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "w": 1,
      "h": 0.32,
      "fill": "#00000055"
    },
    {
      "type": "rect",
      "x": 0,
      "y": 0.7,
      "w": 1,
      "h": 0.3,
      "fill": "#00000077"
    },
    {
      "type": "text",
      "text": "{time.hhmm}",
      "x": 0.5,
      "y": 0.14,
      "size": 0.2,
      "color": "#FFFFFF",
      "align": "center",
      "font": "sans",
      "weight": "bold"
    },
    {
      "type": "text",
      "text": "{time.day}, {time.date}",
      "x": 0.5,
      "y": 0.23,
      "size": 0.04,
      "color": "#E8E8E8",
      "align": "center"
    },
    {
      "type": "text",
      "text": "{sessions.working} working, {sessions.waiting} waiting",
      "x": 0.5,
      "y": 0.74,
      "size": 0.035,
      "color": "#DDDDDD",
      "align": "center"
    },
    {
      "type": "text",
      "text": "{session.1.title}",
      "x": 0.5,
      "y": 0.79,
      "size": 0.045,
      "color": "#FFFFFF",
      "align": "center",
      "visible": "session.1.exists",
      "weight": "bold"
    },
    {
      "type": "text",
      "text": "{session.1.summary}",
      "x": 0.5,
      "y": 0.835,
      "size": 0.032,
      "color": "#DDDDDD",
      "align": "center",
      "visible": "session.1.exists",
      "maxLines": 2,
      "w": 0.84
    }
  ]
}
